{
  "$description": "Mailune brand (local-first mail: a sealed envelope on warm paper). Local deltas only; extends base/tokens.json. Palette matches the macOS shell: canvas, ink, accent. Keys that are not base roles become --mailune-*.",
  "$extends": "../../base/tokens.json",
  "$extensions": {
    "com.pyrlyn.defaultTheme": "light"
  },
  "brand": {
    "$description": "Brand constants, identical in both themes.",
    "ink": {
      "$type": "color",
      "$value": "#1F1F1C",
      "$description": "logo tile"
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2ED",
      "$description": "envelope paper"
    },
    "seal": {
      "$type": "color",
      "$value": "#335C8C",
      "$description": "envelope seal"
    }
  },
  "theme": {
    "$description": "Per theme. Light is the default.",
    "light": {
      "bg": { "$type": "color", "$value": "{brand.paper}" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "surface-2": { "$type": "color", "$value": "#E7E2DA" },
      "border": { "$type": "color", "$value": "#D4CDC3" },
      "fg": { "$type": "color", "$value": "{brand.ink}" },
      "fg-muted": { "$type": "color", "$value": "#5C5852" },
      "fg-subtle": { "$type": "color", "$value": "#8A847C" },
      "accent": { "$type": "color", "$value": "{brand.seal}" },
      "accent-muted": { "$type": "color", "$value": "#D9E6F2" },
      "on-accent": { "$type": "color", "$value": "#FFFFFF" },
      "mark-tile": { "$type": "color", "$value": "{brand.ink}" },
      "accent-bright": { "$type": "color", "$value": "#4C7AAD", "$description": "hover accent" },
      "stage": { "$type": "color", "$value": "#E8E2D8", "$description": "hero stage" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "{brand.ink}" },
      "surface": { "$type": "color", "$value": "#2A2A26" },
      "surface-2": { "$type": "color", "$value": "#34342F" },
      "border": { "$type": "color", "$value": "#4A4842" },
      "fg": { "$type": "color", "$value": "{brand.paper}" },
      "fg-muted": { "$type": "color", "$value": "#C4BEB4" },
      "fg-subtle": { "$type": "color", "$value": "#8A847C" },
      "accent": { "$type": "color", "$value": "#8FB4D9" },
      "accent-muted": { "$type": "color", "$value": "{brand.seal}" },
      "on-accent": { "$type": "color", "$value": "{brand.ink}" },
      "mark-tile": { "$type": "color", "$value": "{brand.ink}" },
      "accent-bright": { "$type": "color", "$value": "#B7D0E8", "$description": "hover accent" },
      "stage": { "$type": "color", "$value": "#171714", "$description": "hero stage" }
    }
  }
}
