{
  "$description": "Pyrlyn base layer: the tokens every brand shares (type, space, radii, sizes, breakpoints, motion, opacity, glass blur) plus the list of semantic colour roles each product brand pack fills in its brand/tokens.json. W3C Design Tokens (DTCG). Generated as --pyr-* by `node build.mjs` into dist/base/tokens.css. Values were taken from the rtok system (see pyrlyn/rtok brand/PROVENANCE.md).",
  "$extensions": {
    "com.pyrlyn.roles": {
      "$description": "Semantic colour roles. Every brand theme defines the core roles; optional roles fall back as listed (the fallbacks are written into base/components/components.css). Each role becomes --pyr-<role> (+ --pyr-<role>-rgb for opaque hex) in each product pack's brand/dist/tokens.css.",
      "core": [
        "bg",
        "surface",
        "surface-2",
        "border",
        "fg",
        "fg-muted",
        "fg-subtle",
        "accent",
        "accent-muted",
        "mark-tile"
      ],
      "optional": {
        "surface-3": "var(--pyr-surface-2)",
        "border-strong": "var(--pyr-border)",
        "accent-fg": "var(--pyr-accent)",
        "on-accent": "var(--pyr-bg)",
        "delta": "var(--pyr-accent)",
        "delta-fg": "var(--pyr-accent)",
        "danger": "var(--pyr-fg)",
        "danger-fg": "var(--pyr-fg)",
        "success": "var(--pyr-fg)",
        "success-fg": "var(--pyr-fg)",
        "warn": "var(--pyr-fg)",
        "warn-fg": "var(--pyr-fg)",
        "focus": "var(--pyr-accent)",
        "shine": "#FFFFFF",
        "selection": "var(--pyr-accent-muted)",
        "glass-alpha": "1",
        "shadow-e1": "none",
        "shadow-e2": "none",
        "shadow-e3": "none"
      }
    }
  },
  "font": {
    "$description": "IBM Plex Mono everywhere (OFL-1.1, fonts/). Sources: web/tailwind.config.js:29, web/src/input.css:7-9, crates/rtok-webui/ui/fonts/README.md, rtok-brand-v3-B-tokens/DESIGN.md typography.",
    "family": {
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "size": {
      "$description": "Dense 4/8pt admin scale, web/tailwind.config.js:33-39; 3xl from v3 DESIGN.md display (28px).",
      "2xs": {
        "$type": "dimension",
        "$value": "0.6875rem",
        "$extensions": {
          "com.listepo.lineHeight": "1rem"
        }
      },
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$extensions": {
          "com.listepo.lineHeight": "1rem"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.8125rem",
        "$extensions": {
          "com.listepo.lineHeight": "1.25rem"
        }
      },
      "base": {
        "$type": "dimension",
        "$value": "0.875rem",
        "$extensions": {
          "com.listepo.lineHeight": "1.5rem"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": "1rem",
        "$extensions": {
          "com.listepo.lineHeight": "1.5rem"
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$extensions": {
          "com.listepo.lineHeight": "1.75rem"
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$extensions": {
          "com.listepo.lineHeight": "2rem"
        }
      },
      "3xl": {
        "$type": "dimension",
        "$value": "1.75rem",
        "$extensions": {
          "com.listepo.lineHeight": "2rem"
        }
      }
    },
    "tracking": {
      "kicker": {
        "$type": "dimension",
        "$value": "0.08em",
        "$description": "uppercase labels, web/src/input.css:89"
      },
      "table-head": {
        "$type": "dimension",
        "$value": "0.06em",
        "$description": "web/src/input.css:91"
      },
      "wordmark": {
        "$type": "dimension",
        "$value": "0.06em",
        "$description": "RTOK wordmark, site/static/logo-wordmark.svg"
      }
    }
  },
  "typography": {
    "$description": "Text styles. Sources: web/tailwind.config.js:33-39 (scale), web/index.html:64 (page title 14px bold), web/src/input.css:89 (kicker), v3 DESIGN.md typography.",
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.3xl}",
        "fontWeight": 700,
        "lineHeight": 1.15,
        "letterSpacing": "0.04em"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.xl}",
        "fontWeight": 700,
        "lineHeight": 1.25,
        "letterSpacing": "0"
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.base}",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.sm}",
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.2xs}",
        "fontWeight": 400,
        "lineHeight": 1.45,
        "letterSpacing": "0"
      }
    },
    "kicker": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.2xs}",
        "fontWeight": 600,
        "lineHeight": 1.45,
        "letterSpacing": "{font.tracking.kicker}"
      }
    },
    "metric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "1.125rem",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "0"
      },
      "$description": "numbers; add font-variant-numeric: tabular-nums"
    }
  },
  "space": {
    "$description": "4/8pt. listepo/landing src/styles/global.css:69-70 (--s-1..--s-8, live) = v3 DESIGN.md spacing (4/8/12/16/24/48).",
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "$description": "web/tailwind.config.js:43.",
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "default UI chrome"
    },
    "lg": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "cards / panels"
    },
    "xl": {
      "$type": "dimension",
      "$value": "14px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "size": {
    "$description": "Control heights. web/src/input.css:62-92 (h-8 control, h-7 chip, h-9 row/nav, 44px touch below md).",
    "control": {
      "$type": "dimension",
      "$value": "32px"
    },
    "control-sm": {
      "$type": "dimension",
      "$value": "28px"
    },
    "row": {
      "$type": "dimension",
      "$value": "36px"
    },
    "touch": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "minimum hit target below md"
    }
  },
  "breakpoint": {
    "$description": "min-width. web/tailwind.config.js:54; 640/1024/1440/1920 shared with site/assets/css/custom.css:11-14 (names differ there, see Conflicts).",
    "xs": {
      "$type": "dimension",
      "$value": "360px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "640px"
    },
    "md": {
      "$type": "dimension",
      "$value": "768px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1024px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1440px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "1920px"
    }
  },
  "motion": {
    "$description": "Durations: web/tailwind.config.js:56 (fast 120ms, base 180ms). Easing: Tailwind default used by the web admin transitions; emphasized curve from listepo/landing global.css:76 (live on /landing/rtok/). Under prefers-reduced-motion: reduce every duration becomes 0.01ms (web/src/input.css:115).",
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms",
        "$description": "hover color, border"
      },
      "base": {
        "$type": "duration",
        "$value": "180ms",
        "$description": "selection background, switch knob, larger state changes"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      },
      "emphasized": {
        "$type": "cubicBezier",
        "$value": [
          0.22,
          1,
          0.36,
          1
        ]
      }
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.4,
      "$description": "web/src/input.css:62-72"
    }
  },
  "effect": {
    "$description": "Glass blur, shared. The glass alpha is per brand and theme (role glass-alpha).",
    "glass-blur": {
      "$type": "dimension",
      "$value": "14px"
    }
  }
}
