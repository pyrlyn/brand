// rtok brand tokens for Slint. Generated by build.mjs from tokens/tokens.json. Do not edit by hand.
// import { Tokens } from "tokens.slint";   then: background: Tokens.bg;  Tokens.dark = false;
// Slint has no prefers-reduced-motion: set durations to 0ms yourself when the OS asks.
export global Tokens {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #06101A : #F4F8FB;
    out property <color> surface: dark ? #0A1622 : #FFFFFF;
    out property <color> surface-2: dark ? #0F1E2E : #E8EEF4;
    out property <color> surface-3: dark ? #15283C : #DCE5EE;
    out property <color> border: dark ? #1A3348 : #C5D3E0;
    out property <color> border-strong: dark ? #2A4A66 : #9BB0C4;
    out property <color> fg: dark ? #E8F7FF : #0B1A24;
    out property <color> fg-muted: dark ? #8AA8BC : #4F6679;
    out property <color> fg-subtle: dark ? #7F9AAE : #5A7388;
    out property <color> accent: #5CE1FF;
    out property <color> accent-fg: dark ? #5CE1FF : #006F8C;
    out property <color> accent-muted: dark ? #5CE1FF33 : #5CE1FF29;
    out property <color> on-accent: #06101A;
    out property <color> delta: #FF6B4A;
    out property <color> delta-fg: dark ? #FF6B4A : #B8361C;
    out property <color> danger: #FF6B4A;
    out property <color> danger-fg: dark ? #FF6B4A : #B8361C;
    out property <color> success: #3DDC97;
    out property <color> success-fg: dark ? #3DDC97 : #0B7A50;
    out property <color> warn: #F5C451;
    out property <color> warn-fg: dark ? #F5C451 : #8A5A00;
    out property <color> focus: dark ? #5CE1FF : #006F8C;
    out property <color> mark-tile: dark ? #06101A : #0B1A24;
    out property <color> shine: dark ? #E8F7FF : #FFFFFF;
    out property <color> selection: #5CE1FF4D;

    out property <color> brand-cyan: #5CE1FF;
    out property <color> brand-coral: #FF6B4A;
    out property <color> brand-navy: #06101A;
    out property <color> brand-ink: #0B1A24;
    out property <color> brand-green: #3DDC97;
    out property <color> brand-amber: #F5C451;
    out property <string> font-family: "IBM Plex Mono";
    out property <int> weight-regular: 400;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
    out property <length> text-2xs: 11px;
    out property <length> text-xs: 12px;
    out property <length> text-sm: 13px;
    out property <length> text-base: 14px;
    out property <length> text-lg: 16px;
    out property <length> text-xl: 20px;
    out property <length> text-2xl: 24px;
    out property <length> text-3xl: 28px;
    out property <length> space-0: 0px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;
    out property <length> space-6: 32px;
    out property <length> space-7: 48px;
    out property <length> space-8: 64px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 10px;
    out property <length> radius-xl: 14px;
    out property <length> radius-full: 9999px;
    out property <length> size-control: 32px;
    out property <length> size-control-sm: 28px;
    out property <length> size-row: 36px;
    out property <length> size-touch: 44px;
    out property <length> size-sidebar: 200px;
    out property <length> size-sidebar-rail: 56px;
    out property <length> bp-xs: 360px;
    out property <length> bp-sm: 640px;
    out property <length> bp-md: 768px;
    out property <length> bp-lg: 1024px;
    out property <length> bp-xl: 1440px;
    out property <length> bp-2xl: 1920px;
    out property <duration> duration-fast: 120ms;
    out property <duration> duration-base: 150ms;
    out property <duration> duration-slow: 180ms;
    out property <float> opacity-disabled: 0.4;
}
